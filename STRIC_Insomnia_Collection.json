      "body": {
        "mimeType": "multipart/form-data",
        "params": [
          {
            "name": "arquivo",
            "type": "file",
            "description": "Selecione um arquivo .pdf genuíno de currículo"
          }
        ]
      },
      "_type": "request"
    },
    {
      "_id": "req_list_candidatos_vaga",
